  "flag_policy": {
    "language": "GNU17 is an explicit analysis choice matching the pinned Clang20 C default; XNU MakeInc.def does not prescribe a C -std value.",
    "included": "Pinned source -mkernel semantics and explicit iPhoneOS deployment platform macros; small ARM64 memory/link flags from MakeInc.def438-472. BSD component contexts use bsd/conf/Makefile.template flags instead of MACH_KERNEL_PRIVATE. Global source -Wno-unknown-warning-option is represented by an explicit diagnostic pragma in the hashed analysis entry; no header or attribute is stripped.",
    "excluded": "No Apple bounds-safety compiler mode, SDK/deployment version or Apple-private ABI claim. Real upstream arm64e ptrauth intrinsics/calls remain enabled in every supported profile. The explicitly authorized analysis-entry #define __ptrauth(...) erases only qualifier annotations; original header bytes and all PAC-conditional fields remain present. Code generation, optimization, instrumentation, signing and runtime authentication semantics are outside this syntax/layout analysis.",
    "target": "Versionless arm64e-apple-ios with genuine upstream PAC feature switches enabled; no SDKVERSION/deployment minimum supplied or spoofed. LLVM20 raw qualifier support is absent, so the visible layout-only variadic __ptrauth macro removes annotations without disabling feature guards or omitting fields. No Apple-private or shipping-device ABI claim."
  },
  "platform": "iPhoneOS",
  "inventory": "profiles/structure-catalog.json",
  "diagnostic_preamble": "#define __ptrauth(...)\n#pragma clang diagnostic ignored \"-Wunknown-warning-option\"\n#if __has_feature(ptrauth_intrinsics)\n#define PLATYDOC_PTRAUTH_INTRINSICS 1\n#else\n#define PLATYDOC_PTRAUTH_INTRINSICS 0\n#endif\n#if __has_feature(ptrauth_calls)\n#define PLATYDOC_PTRAUTH_CALLS 1\n#else\n#define PLATYDOC_PTRAUTH_CALLS 0\n#endif\n#if __has_feature(ptrauth_qualifier)\n#define PLATYDOC_PTRAUTH_QUALIFIER 1\n#else\n#define PLATYDOC_PTRAUTH_QUALIFIER 0\n#endif\n",
